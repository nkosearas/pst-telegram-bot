[Unit]
Description=PST Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pst-telegram-bot
EnvironmentFile=/home/pi/pst-telegram-bot/.env
ExecStart=/home/pi/pst-telegram-bot/venv/bin/python /home/pi/pst-telegram-bot/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
